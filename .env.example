# CausalCredit Environment Variables
# Copy this file to .env and fill in your values

# Data directories
HOME_CREDIT_DATA_DIR=data/home-credit-default-risk/
LENDING_CLUB_DATA_DIR=data/lending-club/
PROCESSED_DATA_DIR=data/processed/
MODELS_DIR=models/

# API configuration
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=info

# Streamlit configuration
STREAMLIT_PORT=8501
STREAMLIT_API_URL=http://localhost:8000

# MLflow tracking (optional)
MLFLOW_TRACKING_URI=http://localhost:5000
# MLFLOW_S3_ENDPOINT_URL=

# Kaggle API (for dataset download)
# KAGGLE_USERNAME=your_username
# KAGGLE_KEY=your_api_key

# PostgreSQL (optional, for production storage)
# DATABASE_URL=postgresql://user:password@localhost:5432/causalcredit

# Redis (optional, for caching)
# REDIS_URL=redis://localhost:6379/0
